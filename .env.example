# Local development only. Generate a private random value before use.
SECRET_KEY=replace-with-a-random-local-development-secret
FLASK_DEBUG=1
COOKIE_SECURE=0

# Seed demo accounts and fictional sample records in a local demo database.
SEED_DEMO_DATA=1

